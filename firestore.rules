rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Validation Blueprints ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'role', 'isApproved']) &&
             data.keys().size() <= 6 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['admin', 'aspirante'] &&
             data.isApproved is bool;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['user_id', 'materia', 'score', 'total_questions', 'date']) &&
             data.user_id == request.auth.uid &&
             data.materia is string && data.materia.size() <= 100 &&
             data.score is int && data.score >= 0 &&
             data.total_questions is int && data.total_questions > 0 &&
             data.score <= data.total_questions &&
             data.date is string; // Date stored as ISO string per DataService
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['user_id', 'question_id', 'materia', 'tema', 'is_correct', 'date']) &&
             data.user_id == request.auth.uid &&
             data.question_id is string && data.question_id.size() <= 128 &&
             data.materia is string && data.materia.size() <= 100 &&
             data.tema is string && data.tema.size() <= 200 &&
             data.is_correct is bool &&
             data.date is string;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().role == 'aspirante' && incoming().isApproved == false;
      allow update: if (isOwner(userId) && isValidUser(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email'])) || isAdmin();
    }

    match /sessions/{sessionId} {
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidSession(incoming()) && incoming().user_id == request.auth.uid;
      allow delete: if isSignedIn() && existing().user_id == request.auth.uid;
    }

    match /progress/{progressId} {
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidProgress(incoming()) && incoming().user_id == request.auth.uid;
      allow delete: if isSignedIn() && existing().user_id == request.auth.uid;
    }
  }
}
